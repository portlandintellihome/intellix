# Production environment for the Vite web build (used by `npm run build`).
# The iOS app (Capacitor) bundles this build, so the API base must be an
# absolute URL — there is no dev proxy inside the native WebView.
#
# NOTE: the codebase reads `import.meta.env.VITE_API_URL` (see src/lib/api.js
# and the per-page fetch helpers), so the variable name must be VITE_API_URL,
# not VITE_API_BASE_URL. Every call site falls back to a relative URL ('') when
# unset, which is what local `npm run dev` relies on (Vite proxies /api).
VITE_API_URL=https://intellix-production.up.railway.app
