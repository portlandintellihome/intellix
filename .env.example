DATABASE_URL=postgres://user:password@localhost:5432/intellix
PORT=3001

# Signing secret for JWT auth tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Anthropic API key for Intellix Assist (claude-sonnet-4-6).
# Create one at https://console.anthropic.com. Leave unset to disable Assist.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for internal automation endpoints (n8n / cron) — the check-in
# and SMS "process-due" pollers send it as the X-Internal-Key header.
INTELLIX_INTERNAL_KEY=replace-me-with-a-long-random-string

# Twilio SMS. One company-wide sending number. Leave any unset to disable SMS
# sending — messages still queue + log, they just aren't transmitted until set.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15035550123

# Frontend — leave unset in production (same-origin via Express).
# Override for dev only if you aren't using the Vite /api proxy.
# VITE_API_URL=http://localhost:3001
