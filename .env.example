DATABASE_URL=postgres://user:password@localhost:5432/intellix
PORT=3001

# Signing secret for JWT auth tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Anthropic API key for Intellix Assist (claude-sonnet-4-6).
# Create one at https://console.anthropic.com. Leave unset to disable Assist.
ANTHROPIC_API_KEY=sk-ant-...

# Frontend — leave unset in production (same-origin via Express).
# Override for dev only if you aren't using the Vite /api proxy.
# VITE_API_URL=http://localhost:3001
